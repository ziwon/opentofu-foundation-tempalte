# Copy to .env.aws.dev, set the profile, then run `just use aws.dev`.
# The account, region, and state bucket stay in each root's terraform.tfvars.json
# and backend.tf. This file only picks the environment, cloud, and CLI credentials.
DEPLOY_ENV=dev
DEPLOY_CLOUD=aws
AWS_PROFILE=REPLACE_ME_AWS_PROFILE
AWS_REGION=us-east-1

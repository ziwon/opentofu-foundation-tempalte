# Copy to .env.azure.dev, then run `just use azure.dev`.
# The subscription and state account stay in each root's terraform.tfvars.json
# and backend.tf. To keep this context's az login apart from others, uncomment
# AZURE_CONFIG_DIR and point it at its own directory.
DEPLOY_ENV=dev
DEPLOY_CLOUD=azure
# AZURE_CONFIG_DIR=/absolute/path/to/azure-dev
